import java.util.Objects;

/**
 * Handles the registration and login requirements for Part 1.
 */
public class Login {

    public static final String USERNAME_SUCCESS =
            "Username successfully captured.";

    public static final String USERNAME_ERROR =
            "Username is not correctly formatted; please ensure that your "
                    + "username contains an underscore and is no more than "
                    + "five characters in length.";

    public static final String PASSWORD_SUCCESS =
            "Password successfully captured.";

    public static final String PASSWORD_ERROR =
            "Password is not correctly formatted; please ensure that the "
                    + "password contains at least eight characters, a "
                    + "capital letter, a number, and a special character.";

    public static final String PHONE_SUCCESS =
            "Cell phone number successfully added.";

    public static final String PHONE_ERROR =
            "Cell phone number incorrectly formatted or does not contain "
                    + "international code.";

    public static final String REGISTRATION_SUCCESS =
            "User registered successfully.";

    public static final String LOGIN_FAILURE =
            "Username or password incorrect, please try again.";

    private final String firstName;
    private final String lastName;
    private final String username;
    private final String password;
    private final String cellPhoneNumber;

    private boolean loginSuccessful;

    public Login(
            String firstName,
            String lastName,
            String username,
            String password,
            String cellPhoneNumber
    ) {
        this.firstName = firstName;
        this.lastName = lastName;
        this.username = username;
        this.password = password;
        this.cellPhoneNumber = cellPhoneNumber;
    }

    public Login(
            String firstName,
            String lastName,
            String username,
            String password
    ) {
        this(firstName, lastName, username, password, "");
    }

    public Login(String username, String password) {
        this("User", "", username, password, "");
    }

    /**
     * Checks that the username contains an underscore
     * and is no longer than five characters.
     */
    public boolean checkUserName() {
        return username != null
                && username.length() <= 5
                && username.matches("^[A-Za-z0-9]*_[A-Za-z0-9]*$");
    }

    /**
     * Checks that the password:
     * - Has at least eight characters
     * - Contains a capital letter
     * - Contains a number
     * - Contains a special character
     */
    public boolean checkPasswordComplexity() {
        return password != null
                && password.matches(
                        "^(?=.*[A-Z])(?=.*\\d)(?=.*[^A-Za-z0-9]).{8,}$"
                );
    }

    /**
     * Checks that the cellphone number uses South African
     * international format, for example: +27839869976.
     */
    public boolean checkCellPhoneNumber() {
        return cellPhoneNumber != null
                && cellPhoneNumber.matches("^\\+27\\d{9}$");
    }

    /**
     * Registers the user and returns the appropriate message.
     */
    public String registerUser() {
        if (!checkUserName()) {
            return USERNAME_ERROR;
        }

        if (!checkPasswordComplexity()) {
            return PASSWORD_ERROR;
        }

        if (!checkCellPhoneNumber()) {
            return PHONE_ERROR;
        }

        return REGISTRATION_SUCCESS;
    }

    /**
     * Checks whether the entered username and password
     * match the registered details.
     */
    public boolean loginUser(
            String enteredUsername,
            String enteredPassword
    ) {
        loginSuccessful = Objects.equals(username, enteredUsername)
                && Objects.equals(password, enteredPassword);

        return loginSuccessful;
    }

    /**
     * Returns the login status message.
     */
    public String returnLoginStatus() {
        if (!loginSuccessful) {
            return LOGIN_FAILURE;
        }

        return "Welcome "
                + firstName
                + ", "
                + lastName
                + " it is great to see you again.";
    }
}
