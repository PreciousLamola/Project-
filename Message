package quickchatapp;

import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.ArrayList;
import java.util.List;
import java.util.concurrent.ThreadLocalRandom;

public class Message {

    public static final int ID_LENGTH = 10;
    public static final int MAX_MESSAGE_LENGTH = 250;
    public static final String JSON_FILE = "messages.json";

    private static final List<Message> SENT_MESSAGES = new ArrayList<>();

    private final String messageID;
    private final int messageNumber;
    private String recipient;
    private String message;

    public Message(String messageID, int messageNumber,
                   String recipient, String message) {
        this.messageID = messageID;
        this.messageNumber = messageNumber;
        this.recipient = recipient;
        this.message = message;
    }

    public Message(int messageNumber, String recipient, String message) {
        this(generateID(), messageNumber, recipient, message);
    }

    private static String generateID() {
        long number = ThreadLocalRandom.current().nextLong(
                1_000_000_000L, 10_000_000_000L);
        return String.format("%010d", number);
    }

    public String getMessageID() {
        return messageID;
    }

    public String getMessageHash() {
        return createMessageHash();
    }

    public String getMessage() {
        return message;
    }

    public String getMessageText() {
        return message;
    }

    public String getRecipient() {
        return recipient;
    }

    public int getMessageNumber() {
        return messageNumber;
    }

    public void setRecipient(String recipient) {
        this.recipient = recipient;
    }

    public void setMessageText(String message) {
        this.message = message;
    }

    public boolean checkMessageID() {
        return messageID != null && messageID.matches("\\d{10}");
    }

    public String describeMessageID() {
        return "Message ID generated: " + messageID;
    }

    public String checkMessageLength() {
        if (message == null || message.trim().isEmpty()) {
            return "Message cannot be empty.";
        }

        if (message.length() <= MAX_MESSAGE_LENGTH) {
            return "Message ready to send.";
        }

        return "Message exceeds 250 characters by "
                + (message.length() - MAX_MESSAGE_LENGTH)
                + "; please reduce the size.";
    }

    public String checkRecipientCell() {
        if (recipient != null
                && recipient.matches("^\\+\\d{10,15}$")) {
            return "Cell phone number successfully captured.";
        }

        return "Cell phone number must start with + and contain "
                + "10 to 15 digits after the plus sign.";
    }

    public String createMessageHash() {
        String prefix = messageID != null && messageID.length() >= 2
                ? messageID.substring(0, 2) : "00";

        String firstWord = "";
        String lastWord = "";

        if (message != null && !message.trim().isEmpty()) {
            String[] words = message.trim().split("\\s+");

            firstWord = words[0].replaceAll("[^a-zA-Z0-9]", "");
            lastWord = words[words.length - 1]
                    .replaceAll("[^a-zA-Z0-9]", "");
        }

        return (prefix + ":" + messageNumber + ":"
                + firstWord + lastWord).toUpperCase();
    }

    public String sentMessage(int choice) {
        switch (choice) {
            case 1:
                if (!checkMessageID()) {
                    return "Invalid message ID.";
                }

                if (!"Message ready to send.".equals(checkMessageLength())) {
                    return checkMessageLength();
                }

                if (!"Cell phone number successfully captured."
                        .equals(checkRecipientCell())) {
                    return checkRecipientCell();
                }

                SENT_MESSAGES.add(this);
                return "Message successfully sent.";

            case 2:
                return "Message disregarded.";

            case 3:
                try {
                    storeMessage();
                    return "Message successfully stored.";
                } catch (IOException e) {
                    return "Error storing message: " + e.getMessage();
                }

            default:
                return "Invalid choice.";
        }
    }

    // Compatibility with the capitalised method in the original main file.
    public String SentMessage(int choice) {
        return sentMessage(choice);
    }

    private void storeMessage() throws IOException {
        Path path = Paths.get(JSON_FILE);

        String existing = Files.exists(path)
                ? Files.readString(path, StandardCharsets.UTF_8).trim()
                : "";

        String object = "{"
                + "\"messageID\":\"" + escapeJson(messageID) + "\","
                + "\"messageHash\":\"" + escapeJson(getMessageHash()) + "\","
                + "\"recipient\":\"" + escapeJson(recipient) + "\","
                + "\"message\":\"" + escapeJson(message) + "\""
                + "}";

        List<String> objects = new ArrayList<>();

        if (!existing.isEmpty() && !existing.equals("[]")) {
            if (!existing.startsWith("[") || !existing.endsWith("]")) {
                throw new IOException(
                        "Existing JSON file is not a valid message array.");
            }

            String contents = existing.substring(1, existing.length() - 1)
                    .trim();

            if (!contents.isEmpty()) {
                objects.add(contents);
            }
        }

        objects.add(object);

        String json = "[\n  "
                + String.join(",\n  ", objects)
                + "\n]\n";

        Files.writeString(path, json, StandardCharsets.UTF_8);
    }

    private static String escapeJson(String value) {
        if (value == null) {
            return "";
        }

        return value.replace("\\", "\\\\")
                .replace("\"", "\\\"")
                .replace("\n", "\\n")
                .replace("\r", "\\r")
                .replace("\t", "\\t");
    }

    public String details() {
        return "Message ID: " + messageID + "\n"
                + "Message Hash: " + getMessageHash() + "\n"
                + "Recipient: " + recipient + "\n"
                + "Message: " + message;
    }

    public static String printMessages() {
        if (SENT_MESSAGES.isEmpty()) {
            return "No messages have been sent yet.";
        }

        StringBuilder result = new StringBuilder();

        for (Message sent : SENT_MESSAGES) {
            if (result.length() > 0) {
                result.append("\n\n");
            }

            result.append(sent.details());
        }

        return result.toString();
    }

    public static int returnTotalMessages() {
        return SENT_MESSAGES.size();
    }

    public static int getTotalSentCount() {
        return SENT_MESSAGES.size();
    }

    public static void resetAll() {
        SENT_MESSAGES.clear();
    }
}
